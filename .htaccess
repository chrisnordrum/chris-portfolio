# Custom 404 page
ErrorDocument 404 /404.html

Options -MultiViews
RewriteEngine On

# index.html -> site root
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Strip ".html" from any request (301 to the clean URL)
RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve the .html file for the clean URL (internal, no redirect)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Cache static assets
<IfModule mod_headers.c>
    # Fonts rarely change — cache hard for a year
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # CSS/JS change on deploy — short cache so updates show up
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
